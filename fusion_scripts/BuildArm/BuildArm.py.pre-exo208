"""BuildArm: place exo joints at URDF joint frames and generate the links.

Round 1: G1 URDF, right shoulder. Places `sensor module 2` at J1
(right_shoulder_pitch_joint) and J2 (right_shoulder_roll_joint) and generates
link 12 (rotor pad on J1, stator pad on J2, L-bracket body) - all under ONE new
component so the result can be toggled / moved as a unit next to the existing
arm. Existing components are never touched.

How to run: open the design that contains the existing arm (the one the exo STEP
was exported from), Utilities > Scripts and Add-Ins > BuildArm > Run. The URDF is
taken from URDF_PATH (default: <repo>/g1/g1_29dof.urdf next to this script); a file
dialog only appears if that file is missing. Any previous `generated_R_arm*`
component is deleted first. The message-box text (or the traceback) is also
written to <repo>/gento_luna/exo/exports/buildarm_report.txt.

Occurrence-transform note (measured in this design, which is DIRECT modelling):
the matrix passed to `occurrences.addNewComponent(m)` places the occurrence
straight away and nothing later resets it - adding bodies does not. What does not
work is assigning `transform2` on the occurrence object that collection returns:
it is native to its parent component, and Fusion only accepts transform overrides
on a proxy obtained with `createForAssemblyContext(parent_root_occurrence)`.
Reading `transform2` there returns identity too, which makes a placed occurrence
look unplaced. So placement goes through `set_occ_matrix(occ, m, arm_occ)` and the
report reads back both the proxy transform and the world bounding box of the
module geometry. Link bodies are sketch + extrude features (EXO-58): outlines from
armgen drawn on construction planes placed in the arm frame, with the link
component left at identity.

Everything configurable is in the CONFIG block below. The pure-Python parts
(FK, frames, link numbers) live in armgen.py next to this file.
"""

import os
import sys
import math
import traceback

import adsk.core
import adsk.fusion

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import importlib
import armgen  # noqa: E402
importlib.reload(armgen)  # Fusion caches modules between runs

# ============================== CONFIG ==============================

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_DIR = os.path.normpath(os.path.join(SCRIPT_DIR, '..', '..'))

# URDF file. If it does not exist a file dialog asks for it.
URDF_PATH = os.path.join(REPO_DIR, 'g1', 'g1_29dof.urdf')

# Report text (same as the message box, plus a traceback on failure) is written here.
REPORT_PATH = os.path.join(REPO_DIR, 'gento_luna', 'exo', 'exports', 'buildarm_report.txt')

# Name of the saved Fusion document (or component already in the design) of
# the exo joint. Matched on prefix because linked components get " vNN".
MODULE_DOC_NAME = 'sensor module 2'

# Everything is created under this one new component in the root. Any existing
# root-level component whose name starts with this is deleted at the start of a run.
ARM_COMPONENT_NAME = 'generated_R_arm'

# The existing arm design has its origin on the LEFT J1 rotor-face centre
# (exo STEP frame). Put that URDF joint on the document origin so the generated
# arm overlays the existing one. Set to None for raw URDF (pelvis) coordinates.
ORIGIN_AT_JOINT = 'left_shoulder_pitch_joint'

# Joints to place. axis_sign: module Z (out of the rotor face) = sign * URDF axis.
# y_hint: world direction (URDF frame) the module's +Y (actuator connector side)
# should lean toward. These reproduce the existing right arm as measured in the exo STEP.
#
# EXO-130: y_hint is now the SEED of the rotation about Z, not the answer. The rotation is a
# free parameter of the design and it decides where the three stator inserts, the actuator
# cutout and the rotor index notch sit under the link that lands on them, so it is SOLVED
# (armgen.solve_module_spins) once the frames are built: the measured pose is kept wherever
# it already clears, and moved only where it does not. The build report prints the angle
# chosen at every joint and the window it came from.
JOINTS = [
    {'label': 'J1', 'name': 'right_shoulder_pitch_joint', 'axis_sign': -1, 'y_hint': (0, 0, 1)},
    {'label': 'J2', 'name': 'right_shoulder_roll_joint', 'axis_sign': +1, 'y_hint': (0, 1, 0)},
    {'label': 'J3', 'name': 'right_shoulder_yaw_joint', 'axis_sign': -1, 'y_hint': (-1, 0, 0)},
    # EXO-103: confirmed against the exo `Module 3 R` pose before link_34 was built - this
    # (axis_sign, y_hint) reproduces its orientation to 1.9e-4 rad, the same rounding J1..J3
    # measure, and the J3->J4 pair it makes agrees with the exo's own two modules to 0.003 mm.
    {'label': 'J4', 'name': 'right_elbow_joint', 'axis_sign': -1, 'y_hint': (-1, 0, 0)},
    # EXO-114: confirmed against the exo `Module 4 R` pose before link_45 was built - this
    # (axis_sign, y_hint) reproduces its orientation to 2.07e-4 rad (the same rounding J1..J4
    # measure) and the J4->J5 pair it makes agrees with the exo's own two modules to
    # 0.005 mm. Past J3 the whole arm sits 8.8 mm off the hand-built one by construction
    # (EXO-113), so it is the PAIR that is compared, not the world pose.
    {'label': 'J5', 'name': 'right_wrist_roll_joint', 'axis_sign': +1, 'y_hint': (0, 1, 0)},
]

# Links to generate. a = rotor-pad joint, b = stator-pad joint.
#   width:  the ribbon's width in mm - ESTEBAN'S INPUT PER LINK, never derived (EXO-96).
#           52 for the shoulder (the most loaded and shortest link, the full rotor-pad
#           diameter of the hand-built Link 1 R) and 25 for the bar (Link 2 R).
#   expect: the route `armgen.route` is expected to compute ('bar' / 'L'). The router works
#           it out from the two joint frames alone (EXO-81/EXO-96); this is an assertion,
#           not a switch, so a pair that silently changes route stops the build.
#   pad_r: rotor pad radius; stop_angle/stop_half/stop_h: link stop block (deg, deg, mm).
#          HAND-SET, and they limit nothing - EXO-204 derives the block from the joint's
#          URDF limits instead (`armgen.limited_joint`), which `BuildArmGen.LIMITED_JOINTS`
#          turns on joint by joint. J1's generated block comes out at the same +/-5 deg this
#          list carries, from the URDF alone. These stay until every joint is reviewed.
LINKS = [
    {'a': 'J1', 'b': 'J2', 'name': 'link_12', 'expect': 'L', 'width': 52.0,
     'pad_r': 26.0, 'stop_angle': 0.0, 'stop_half': 5.0, 'stop_h': 3.6},
    {'a': 'J2', 'b': 'J3', 'name': 'link_23', 'expect': 'bar', 'width': 25.0,
     'pad_r': 27.0, 'stop_angle': 270.0, 'stop_half': 10.0, 'stop_h': 3.5},
    # EXO-103, the up-column pair. Width, pad radius and the stop block's size are `Link
    # 3 R`'s, measured (EXO-104): a 52 mm ribbon on a r 26 rotor pad - its two walls tangent
    # to the rim, as Link 1 R's are - and a stop block r 20..26 x 3.6 mm, +/-10 deg wide.
    # Its ANGLE is not Link 3 R's 180 deg (the slab side). The exo's right arm is MIRRORED,
    # so its modules carry the stator stop block at about 348 deg; this generator places the
    # unmirrored `sensor module 2` at every joint, where that block sits at 158..178 deg
    # (EXO-77) - exactly where Link 3 R's own block is. 0 deg puts the link's block
    # diametrically opposite it, as link_12 already does. Joint limits are deferred (EXO-41).
    {'a': 'J3', 'b': 'J4', 'name': 'link_34', 'expect': 'L', 'width': 52.0,
     'pad_r': 26.0, 'stop_angle': 0.0, 'stop_half': 10.0, 'stop_h': 3.6},
    # EXO-114, the ramp. Width, pad radius and the stop block's size are `Link 4 R`'s,
    # measured: a 44 mm ribbon on a r 27 rotor pad - which is also the widest band that stays
    # inside BOTH rims of this pair (27 + 27 - 10), the thing that lets the plan taper take
    # the whole 10 mm lateral - and a stop block r 20..27 x 3.6 mm, +/-10 deg wide. Its ANGLE
    # is not Link 4 R's 180 deg (opposite the run): this generator places the UNMIRRORED
    # `sensor module 2`, whose own stator block sits at 158..178 deg (EXO-77/EXO-111), so the
    # link's block goes to 0 deg - diametrically opposite it, as link_12 and link_34 do.
    {'a': 'J4', 'b': 'J5', 'name': 'link_45', 'expect': 'ramp', 'width': 44.0,
     'pad_r': 27.0, 'stop_angle': 0.0, 'stop_half': 10.0, 'stop_h': 3.6},
]

# ====================================================================

M_TO_CM = 100.0    # URDF meters -> Fusion API centimeters
MM_TO_CM = 0.1


def P(x, y, z):
    """Point3D from millimeters."""
    return adsk.core.Point3D.create(x * MM_TO_CM, y * MM_TO_CM, z * MM_TO_CM)


def V(x, y, z):
    return adsk.core.Vector3D.create(x, y, z)


def matrix_from_frame(R, t_cm):
    m = adsk.core.Matrix3D.create()
    m.setWithArray([
        R[0][0], R[0][1], R[0][2], t_cm[0],
        R[1][0], R[1][1], R[1][2], t_cm[1],
        R[2][0], R[2][1], R[2][2], t_cm[2],
        0.0, 0.0, 0.0, 1.0])
    return m


# ---------------- link bodies: sketches on construction planes + extrudes (EXO-58) ----------------
# A link is built from real Fusion features inside its own component: a construction plane
# from a world Plane (`ConstructionPlaneInput.setByPlane`, valid in direct designs), a
# sketch on it holding an armgen outline (lines + three-point arcs, every point converted
# with `modelToSketchSpace`), and an extrude with a SYMMETRIC full-length extent about the
# plane (so nothing depends on which way the plane normal points). Joins and cuts are
# extrudes with `participantBodies`, so pads and body end as ONE body. Measured API facts
# (tools/bridge_scripts/probe_sketch_extrude.py, this design): setSymmetricExtent(d, True)
# gives d in total; SketchArc.start/endSketchPoint follow the arc's own orientation, so
# curves are chained by coordinates and never through an arc's end point.

class Frame:
    """Rigid frame in the arm frame (= world: the arm and link components sit at identity).
    R columns = frame axes in world, t in mm."""

    def __init__(self, R, t_mm):
        self.R, self.t = R, list(t_mm)

    def child(self, R_rel, t_rel_mm):
        return Frame(armgen.matmul(self.R, R_rel), self.xyz(t_rel_mm))

    def xyz(self, p):
        return [self.t[i] + sum(self.R[i][k] * p[k] for k in range(3)) for i in range(3)]

    def point(self, p):
        return P(*self.xyz(p))

    def vector(self, v):
        return V(*armgen.matvec(self.R, v))


class PlaneSketch:
    """A sketch on the plane through `origin` (world Point3D, cm) spanned by the world unit
    vectors e1, e2; 2D outline coordinates (a, b) in mm map to origin + a*e1 + b*e2."""

    def __init__(self, comp, name, origin, e1, e2):
        self.comp, self.name, self.origin, self.e1, self.e2 = comp, name, origin, e1, e2
        pin = comp.constructionPlanes.createInput()
        if not pin.setByPlane(adsk.core.Plane.create(origin, e1.crossProduct(e2))):
            raise RuntimeError('%s: ConstructionPlaneInput.setByPlane refused' % name)
        self.cplane = comp.constructionPlanes.add(pin)
        self.cplane.name = name + ' plane'
        self.sketch = comp.sketches.add(self.cplane)
        self.sketch.name = name

    def pt(self, a, b):
        w = adsk.core.Point3D.create(
            self.origin.x + (a * self.e1.x + b * self.e2.x) * MM_TO_CM,
            self.origin.y + (a * self.e1.y + b * self.e2.y) * MM_TO_CM,
            self.origin.z + (a * self.e1.z + b * self.e2.z) * MM_TO_CM)
        return self.sketch.modelToSketchSpace(w)

    def loop(self, segs):
        """Closed armgen outline: ('line', p0, p1) / ('arc', p0, p_mid, p1, centre, r)."""
        if not armgen.profile_closed(segs):
            raise RuntimeError('%s: outline is not a closed loop' % self.name)
        lines = self.sketch.sketchCurves.sketchLines
        arcs = self.sketch.sketchCurves.sketchArcs
        for sg in segs:
            if sg[0] == 'line':
                lines.addByTwoPoints(self.pt(*sg[1]), self.pt(*sg[2]))
            elif sg[0] == 'arc':
                arcs.addByThreePoints(self.pt(*sg[1]), self.pt(*sg[2]), self.pt(*sg[3]))
            else:
                raise ValueError('%s: unknown segment %r' % (self.name, sg[0]))

    def circle(self, c, r):
        self.sketch.sketchCurves.sketchCircles.addByCenterRadius(self.pt(*c), r * MM_TO_CM)

    def extrude(self, expect_profiles, length_mm, op, body=None):
        """Symmetric extrude of all profiles (their count must be `expect_profiles`) by
        `length_mm` in total; `body` = participant for join / cut. Hides the sketch and
        plane afterwards. Returns the ExtrudeFeature; raises with the step name on failure."""
        n = self.sketch.profiles.count
        if n != expect_profiles:
            raise RuntimeError('%s: sketch has %d profile(s), expected %d' % (self.name, n, expect_profiles))
        profs = adsk.core.ObjectCollection.create()
        for i in range(n):
            profs.add(self.sketch.profiles.item(i))
        feats = self.comp.features.extrudeFeatures
        inp = feats.createInput(profs, op)
        inp.setSymmetricExtent(adsk.core.ValueInput.createByReal(length_mm * MM_TO_CM), True)
        if body is not None:
            inp.participantBodies = [body]
        try:
            feat = feats.add(inp)
        except Exception as e:
            raise RuntimeError('%s: extrude (%s, %.2f mm) failed: %s' % (self.name, op, length_mm, e))
        if feat is None:
            raise RuntimeError('%s: extrude returned nothing' % self.name)
        feat.name = self.name
        self.sketch.isVisible = False
        self.cplane.isLightBulbOn = False
        return feat


SPIN_LINKS = [(L['name'], L['a'], L['b'], L['pad_r'], L['width']) for L in LINKS]


def arm_frames(joints, by_child, shift=(0.0, 0.0, 0.0)):
    """The module frames this build places, and nothing else's idea of them.

    `y_hint` in JOINTS is the SEED - the rotation about the module axis measured in the exo
    STEP. The rotation itself is SOLVED (EXO-130): it decides where the three stator inserts,
    the actuator cutout and the rotor index notch sit under the link that lands on them, and
    a joint is the stator end of one link and the rotor end of the next, so the whole chain
    is solved at once and then re-proved closed on the solved frames.

    Returns (frames, spins, chain). Every bridge script that has to measure what was built
    calls THIS, so no measurement can be made against an arm that was never drawn.
    """
    frames = {}
    for j in JOINTS:
        R, t = armgen.module_frame(j['name'], joints, by_child, j['axis_sign'], j['y_hint'])
        frames[j['label']] = (R, [t[i] - shift[i] for i in range(3)])
    frames, spins = armgen.spun_frames(frames, SPIN_LINKS)
    return frames, spins, armgen.spin_chain_check(frames, SPIN_LINKS, spins)


JOIN_OVERLAP = 1.0   # mm a stop block / index tab extends up INTO the pad so the join overlaps in volume


def build_link_body(comp, FA, R_ab, t_ab, spec, routed):
    """Build the link's single solid in component `comp`. FA = rotor-pad frame A in the arm
    frame (Frame); (R_ab, t_ab) = stator frame B in A (mm); `routed` = the LinkSpec from
    armgen.route. Returns (BRepBody, info dict)."""
    g = armgen
    NEW = adsk.fusion.FeatureOperations.NewBodyFeatureOperation
    JOIN = adsk.fusion.FeatureOperations.JoinFeatureOperation
    CUT = adsk.fusion.FeatureOperations.CutFeatureOperation
    ISECT = adsk.fusion.FeatureOperations.IntersectFeatureOperation
    pad_r = spec['pad_r']
    pattern, info = routed['pattern'], routed['geometry']
    eps = 0.5
    # FB = the stator frame as the URDF gives it: the insert holes and the actuator cutout
    # are cut there, where they mate (the cutout has zero clearance to the XL330). FS = the
    # frame the slab BODY is drawn in - B snapped so its connector side runs along the pad
    # axis and its own axis lies in the pad plane, so tongue and link walls are the same
    # planes (EXO-61). The snap is 1.9e-4 rad for the G1 bar and a real 16 deg for the
    # shoulder L, which is why the cuts stay in FB.
    FB = FA.child(R_ab, t_ab)
    FS = FA.child(info['R_b'], t_ab)
    u, w = info['u'], info['w']
    ex, ey, ez = FA.vector([1, 0, 0]), FA.vector([0, 1, 0]), FA.vector([0, 0, 1])
    bx, by = FB.vector([1, 0, 0]), FB.vector([0, 1, 0])
    sx, sy = FS.vector([1, 0, 0]), FS.vector([0, 1, 0])
    z_slab_mid = g.STATOR_UNDERSIDE_Z - g.PAD_T / 2

    # --- the route's side profile comes first (armgen.route_profile: one renderer for any
    #     route, EXO-96). When the route carries a PLAN BAND - the S (EXO-64; placement
    #     EXO-69) or the ramp's taper (EXO-114) - the profile is extruded WIDE about the
    #     rotor pad's own centre plane and then INTERSECTED with that band, which is what
    #     puts the shape on its two walls. Everything else (pad disk, slab, cuts) joins into
    #     that body afterwards. Without a band the profile is simply extruded to the ribbon's
    #     width about its own centre plane, as in EXO-58; `profile_w` is the w that plane
    #     sits on, which the route decides.
    pb = info['plan_band']
    off = info['profile_w']
    sk = PlaneSketch(comp, '%s side profile' % pattern,
                     FA.point([w[0] * off, w[1] * off, 0.0]), FA.vector(u), ez)
    sk.loop(info['profile'])
    body = sk.extrude(1, pb['wide_w'] if pb else info['width'], NEW).bodies.item(0)
    if pb:
        sk = PlaneSketch(comp, '%s %s plan' % (pattern, info['offset_taken']),
                         FA.point([0, 0, pb['z_mid']]), FA.vector(u), FA.vector(w))
        sk.loop(pb['band'])
        sk.extrude(1, pb['z_span'], ISECT, body)

    # --- rotor pad disk: joins into the profile body ---
    sk = PlaneSketch(comp, 'rotor pad', FA.point([0, 0, g.PAD_T / 2]), ex, ey)
    sk.circle((0, 0), pad_r)
    sk.extrude(1, g.PAD_T, JOIN, body)

    # --- stator slab: the disk with its flange tongue and the tongue's blends, drawn in FS ---
    sk = PlaneSketch(comp, 'stator pad + flange', FS.point([0, 0, z_slab_mid]), sx, sy)
    sk.loop(info['flange'])
    sk.extrude(1, g.PAD_T, JOIN, body)

    # --- the one rounded edge a JOIN cannot make: the corner round at the stator slab's FAR
    #     face, cut in the side-profile plane. The bar's r 7.9 tongue-end round and the
    #     shoulder's r 5.5 elbow round are the same feature of the same join, so there is one
    #     cut (armgen.route_corner_cut); the route says how wide it is and which w it is
    #     centred on - the tongue's, which is w_off when an S brought the band there and 0
    #     when the offset went into the slab.
    cc = info['corner_cut_w_centre']
    sk = PlaneSketch(comp, 'slab corner round',
                     FA.point([w[0] * cc, w[1] * cc, 0.0]), FA.vector(u), ez)
    sk.loop(info['corner_cut'])
    sk.extrude(1, info['corner_cut_w'], CUT, body)

    # --- stop block (ring sector below the pad face) and index tab, joined with overlap ---
    stop_h, half, ang = spec['stop_h'], spec['stop_half'], spec['stop_angle']
    sk = PlaneSketch(comp, 'stop block', FA.point([0, 0, (JOIN_OVERLAP - stop_h) / 2]), ex, ey)
    sk.loop(g.stop_block_outline(ang, half, g.STOP_R_IN, pad_r))
    sk.extrude(1, stop_h + JOIN_OVERLAP, JOIN, body)
    sk = PlaneSketch(comp, 'index tab', FA.point([0, 0, (JOIN_OVERLAP - g.TAB_H) / 2]), ex, ey)
    sk.loop(g.rect_outline(-g.TAB_W / 2, g.TAB_R_IN, g.TAB_W / 2, g.TAB_R_OUT))
    sk.extrude(1, g.TAB_H + JOIN_OVERLAP, JOIN, body)

    # --- rotor-side cuts: 4x M3 through the pad ---
    sk = PlaneSketch(comp, 'rotor holes', FA.point([0, 0, g.PAD_T / 2]), ex, ey)
    for a in g.ROTOR_HOLE_ANGLES:
        sk.circle((g.ROTOR_HOLE_RADIUS * math.cos(math.radians(a)),
                   g.ROTOR_HOLE_RADIUS * math.sin(math.radians(a))), g.HOLE_R)
    sk.extrude(len(g.ROTOR_HOLE_ANGLES), g.PAD_T + 2 * eps, CUT, body)

    # --- stator-side cuts: 3 insert holes + actuator cutout through the slab ---
    sk = PlaneSketch(comp, 'stator holes + cutout', FB.point([0, 0, z_slab_mid]), bx, by)
    for a in g.INSERT_ANGLES:
        sk.circle((g.INSERT_RADIUS * math.cos(math.radians(a)),
                   g.INSERT_RADIUS * math.sin(math.radians(a))), g.HOLE_R)
    sk.loop(g.rect_outline(g.CUTOUT_X[0], g.CUTOUT_Y[0], g.CUTOUT_X[1], g.CUTOUT_Y[1]))
    sk.extrude(len(g.INSERT_ANGLES) + 1, g.PAD_T + 2 * eps, CUT, body)

    if comp.bRepBodies.count != 1:
        raise RuntimeError('%s: %d bodies after the build, expected one solid'
                           % (comp.name, comp.bRepBodies.count))
    return comp.bRepBodies.item(0), info


# ---------------- Fusion document helpers ----------------

def find_module_component(design):
    for comp in design.allComponents:
        if comp.name == MODULE_DOC_NAME or comp.name.startswith(MODULE_DOC_NAME + ' v'):
            return comp
    return None


def find_data_file(app, name):
    project = app.data.activeProject
    if project is None:
        return None
    stack = [project.rootFolder]
    while stack:
        folder = stack.pop()
        for i in range(folder.dataFiles.count):
            f = folder.dataFiles.item(i)
            if f.name == name:
                return f
        for i in range(folder.dataFolders.count):
            stack.append(folder.dataFolders.item(i))
    return None


def unique_name(design, base):
    names = set(c.name for c in design.allComponents)
    if base not in names:
        return base
    k = 2
    while '%s (%d)' % (base, k) in names:
        k += 1
    return '%s (%d)' % (base, k)


def write_report(text):
    """Best effort; never raises."""
    try:
        d = os.path.dirname(REPORT_PATH)
        if not os.path.isdir(d):
            os.makedirs(d)
        with open(REPORT_PATH, 'w') as f:
            f.write(text)
        return True
    except Exception:
        return False


def collect_bodies(occ, prefix=None, bodies=None, names=None):
    """All BRep bodies under an occurrence, any depth (links AND the module bodies that
    sit one level deeper under each J* wrapper). Returns (ObjectCollection, {token: path})."""
    if bodies is None:
        bodies = adsk.core.ObjectCollection.create()
        names = {}
    prefix = occ.component.name if prefix is None else prefix
    for i in range(occ.bRepBodies.count):
        b = occ.bRepBodies.item(i)
        bodies.add(b)
        names[b.entityToken] = prefix + '/' + b.name
    for i in range(occ.childOccurrences.count):
        sub = occ.childOccurrences.item(i)
        collect_bodies(sub, prefix + '>' + sub.component.name, bodies, names)
    return bodies, names


def body_label(b):
    """analyzeInterference hands back NATIVE bodies (assemblyContext None, entityToken not
    the one of the proxy we fed in - measured, tools/bridge_scripts/probe_interference_ids.py),
    so the only stable identity is parent component + body name."""
    return '%s/%s' % (b.parentComponent.name, b.name)


def analyze_interference(design, bodies):
    """design.analyzeInterference over `bodies` (coincident faces ignored).
    Returns [(label_a, label_b, volume_mm3, ((xlo,ylo,zlo),(xhi,yhi,zhi)) world mm or None)]."""
    if bodies.count < 2:
        return []
    inp = design.createInterferenceInput(bodies)
    inp.areCoincidentFacesIncluded = False
    res = design.analyzeInterference(inp)
    out = []
    if res is None:
        return out
    for i in range(res.count):
        r = res.item(i)
        a, b = body_label(r.entityOne), body_label(r.entityTwo)
        vol, bb = -1.0, None
        ib = r.interferenceBody
        if ib is not None:
            vol = ib.volume * 1000.0
            box = ib.boundingBox
            bb = ((box.minPoint.x * 10, box.minPoint.y * 10, box.minPoint.z * 10),
                  (box.maxPoint.x * 10, box.maxPoint.y * 10, box.maxPoint.z * 10))
        out.append((a, b, vol, bb))
    return out


def hit_key(a, b, vol, bb):
    """Identity of one interference across runs: labels, volume and world bbox (0.01 mm)."""
    box = None if bb is None else tuple(round(v, 2) for v in bb[0] + bb[1])
    return (tuple(sorted((a, b))), round(vol, 2), box)


ACTUATOR_BODY_TOKEN = 'XL330'      # EXO-201: the real actuator inside every placed module
                                   # (`XL330 v2/Body1`); a hit label carrying this token is
                                   # a hit involving an actuator


def check_interference(design, arm_occ):
    """Post-build check over links + module bodies. Module-internal overlaps (press-fit
    inserts, screws inside one `sensor module 2`) are found by analysing each J* wrapper
    on its own first; a hit of the full run that also appears in a single-wrapper run is
    module-internal, everything else is judged by armgen.classify_interference.
    Returns (n_bodies, [(kind, a, b, vol, bb)]).

    EXO-201: the actuator needs no proxy. `sensor module 2` CARRIES the XL330 (`XL330 v2/
    Body1`, measured at x -10..10, y -9.5..24.5 from its back z -36.5 on up - EXO-187's proxy
    rectangle to 0.000 mm), so it is already one of the wrapper's own bodies and lands in the
    single-wrapper run here: XL330-vs-its-own-stator is module-internal, XL330-vs-a-link is a
    FAIL. That is exactly the grouping EXO-187's proxy was built to get, minus the duplicate
    body that z-fought with the real one in the viewport."""
    internal = set()
    subs = [arm_occ.childOccurrences.item(i) for i in range(arm_occ.childOccurrences.count)]
    for sub in subs:
        n = sub.component.name
        if n.startswith('link_'):
            continue
        sub_bodies, names = collect_bodies(sub)
        for a, b, vol, bb in analyze_interference(design, sub_bodies):
            internal.add(hit_key(a, b, vol, bb))
    bodies, _ = collect_bodies(arm_occ)
    out = []
    for a, b, vol, bb in analyze_interference(design, bodies):
        kind = armgen.classify_interference(a, b, bb, hit_key(a, b, vol, bb) in internal)
        out.append((kind, a, b, vol, bb))
    return bodies.count, out


def delete_previous_arms(root):
    """Delete root-level occurrences named ARM_COMPONENT_NAME*. Returns list of names."""
    gone = []
    victims = []
    for i in range(root.occurrences.count):
        occ = root.occurrences.item(i)
        # EXO-144: EXACTLY this component, or one of Fusion's " (2)" copies of it. A plain
        # startswith would also eat `generated_R_arm_general`, the arm the general method
        # builds beside this one for the overlay.
        n = occ.component.name
        if n == ARM_COMPONENT_NAME or n.startswith(ARM_COMPONENT_NAME + ' ('):
            victims.append(occ)
    for occ in victims:
        name = occ.component.name
        if occ.deleteMe():
            gone.append(name)
        else:
            raise RuntimeError('could not delete previous component "%s"' % name)
    return gone


def occ_root_proxy(occ, parent_occ=None):
    """The same occurrence seen from the root component.

    An occurrence created through `some_component.occurrences` is *native* to that
    component (its assemblyContext is None) and Fusion refuses transform overrides
    on it: "transform overrides can only be set on Occurrence proxy from root
    component". `parent_occ` is the root-context occurrence of the owning
    component; None means `occ` already hangs off the root.
    """
    if parent_occ is None or occ.assemblyContext is not None:
        return occ
    return occ.createForAssemblyContext(parent_occ)


def occ_matrix(occ, parent_occ=None):
    """Occurrence transform relative to its parent, read where it is readable.

    `transform2` on a native (non-root-context) occurrence reads back as identity
    even when the occurrence is placed - measured in this design, see
    .knuth/docs/fusion-bridge.md - so the read goes through the root proxy and
    uses `transform`, which is correct in every context.
    """
    return occ_root_proxy(occ, parent_occ).transform


def set_occ_matrix(occ, m, parent_occ=None):
    """Place `occ` at `m` (relative to its parent). Returns how it was set.

    `transform2` only takes an assignment on a root-context proxy; on a direct
    design the deprecated `transform` setter works on the native occurrence and
    does move the geometry (verified by world bounding box).
    """
    target = occ_root_proxy(occ, parent_occ)
    try:
        target.transform2 = m
        return 'transform2 on %s' % ('proxy' if target is not occ else 'occurrence')
    except RuntimeError:
        occ.transform = m
        return 'transform (fallback)'


def matrix_diff(a, b):
    return max(abs(x - y) for x, y in zip(a.asArray(), b.asArray()))


def describe_matrix(m):
    a = m.asArray()
    return 'pos(mm)=(%.2f, %.2f, %.2f) Z=(%.3f, %.3f, %.3f)' % (
        a[3] * 10, a[7] * 10, a[11] * 10, a[2], a[6], a[10])



class Cancelled(Exception):
    """The user closed the URDF file dialog. Not an error."""


def build_arm(app, ui, design, log=None, interactive=False):
    """Build the generated arm in `design`; return the report text. Raises on failure.

    This is the whole of the old run() body, so it can be called from anywhere: the
    Scripts and Add-Ins entry point below, or a script fed to the AgentBridge add-in:

        import importlib, sys
        sys.path.insert(0, '<repo>/fusion_scripts/BuildArm')
        import BuildArm
        importlib.reload(BuildArm)          # Fusion caches modules between runs
        log(BuildArm.build_arm(app, ui, design, log))

    `log`, if given, receives each report line as it is produced (so a run that raises
    half way still shows what it got to). `interactive` is False by default: nothing
    opens a dialog or a message box, because a modal dialog raised from inside the
    bridge would block Fusion's UI thread forever. The manual run() below passes True.
    """
    report = []

    def rep(line):
        report.append(line)
        if log is not None:
            log(line)

    if not design:
        raise RuntimeError('Open a Fusion design first.')

    # ---- URDF ----
    urdf = URDF_PATH
    if not (urdf and os.path.isfile(urdf)):
        if not interactive:
            raise RuntimeError('URDF not found: %s' % urdf)
        dlg = ui.createFileDialog()
        dlg.title = 'URDF not found at %s - select URDF file' % urdf
        dlg.filter = 'URDF files (*.urdf);;All files (*.*)'
        dlg.isMultiSelectEnabled = False
        if dlg.showOpen() != adsk.core.DialogResults.DialogOK:
            raise Cancelled('cancelled at the URDF file dialog')
        urdf = dlg.filename
    if not os.path.isfile(urdf):
        raise RuntimeError('URDF not found:\n' + urdf)
    joints, by_child = armgen.parse_urdf(urdf)

    wanted = [j['name'] for j in JOINTS] + ([ORIGIN_AT_JOINT] if ORIGIN_AT_JOINT else [])
    missing = [n for n in wanted if n not in joints]
    if missing:
        raise RuntimeError('Joints not found in URDF: ' + ', '.join(missing))
    labels = [j['label'] for j in JOINTS]
    bad = [(L['a'], L['b']) for L in LINKS if L['a'] not in labels or L['b'] not in labels]
    if bad:
        raise RuntimeError('LINKS refer to unknown joint labels: %s' % (bad,))

    # ---- frames (URDF world, meters), then shifted so ORIGIN_AT_JOINT is at the
    #      document origin. The arm component itself stays at identity so that
    #      "relative to parent" and "relative to root" coincide for the wrappers. ----
    shift = [0.0, 0.0, 0.0]
    if ORIGIN_AT_JOINT:
        shift, _ = armgen.joint_world_pose(ORIGIN_AT_JOINT, joints, by_child)
    frames, spins, chain = arm_frames(joints, by_child, shift)

    # ---- link geometry computed before touching the document (fails loudly) ----
    link_specs = []
    for L in LINKS:
        RA, tA = frames[L['a']]
        RB, tB = frames[L['b']]
        R_ab, t_ab = armgen.relative_frame(RA, tA, RB, tB)
        # raises, naming every departure's objection, on a pair no route fits
        spec = armgen.route_relative(R_ab, t_ab, L['pad_r'], width=L['width'])
        if spec['pattern'] != L['expect']:
            raise RuntimeError('%s: the router computed the %r route, LINKS expects %r'
                               % (L['name'], spec['pattern'], L['expect']))
        link_specs.append((L, R_ab, t_ab, spec))

    # ---- pure-Python clearance between every pair of consecutive links that share a joint
    #      (the Fusion interference check after the build is the real test; this gives a
    #      number, and since EXO-103 the hulls cover the whole body so it is a lower bound
    #      whichever route either link takes - it is no longer only run on L -> bar) ----
    clearances = []
    for (L1, R1, t1, s1), (L2, R2, t2, s2) in zip(link_specs, link_specs[1:]):
        if L1['b'] == L2['a']:
            g1, g2 = s1['geometry'], s2['geometry']
            c = armgen.link_clearance(R1, t1, g1, R2, t2, g2)
            clearances.append((L1['name'], L2['name'], c))
            if c < armgen.MIN_CLEARANCE:
                raise RuntimeError('%s / %s computed clearance %.2f mm < %.1f mm minimum'
                                   % (L1['name'], L2['name'], c, armgen.MIN_CLEARANCE))

    root = design.rootComponent
    parametric = design.designType == adsk.fusion.DesignTypes.ParametricDesignType

    # ---- remove previous runs, then locate the module source ----
    gone = delete_previous_arms(root)
    module_comp = find_module_component(design)
    data_file = None
    if module_comp is None:
        data_file = find_data_file(app, MODULE_DOC_NAME)
        if data_file is None:
            raise RuntimeError(
                'Could not find "{}" in this design or the active project. '
                'Save the module document in the same project.'.format(MODULE_DOC_NAME))

    for line in ['URDF: ' + urdf,
                 'S placement: ' + armgen.S_PLACEMENT,
                 'Design type: ' + ('parametric' if parametric else 'direct'),
                 'Deleted previous: ' + (', '.join(gone) if gone else 'none'),
                 'Origin at: ' + (ORIGIN_AT_JOINT or 'URDF pelvis frame'), '']:
        rep(line)
    rep('Module rotation about its own axis, SOLVED (EXO-130):')
    for j in JOINTS:
        f = spins[j['label']]
        rep('  %-3s %+8.3f deg from the measured y_hint - %s%s'
            % (j['label'], f['spin'], f['why'],
               '' if f['margin'] is None
               else '; smallest stator flat ring %.3f mm (need %.2f)'
                    % (f['margin'], armgen.HOLE_FLAT_RING)))
        if f['windows']:
            rep('      feasible %s'
                % ', '.join('%.3f..%.3f deg' % w for w in f['windows']))
    _res = armgen.spin_windows_resolved(spins)
    if _res is not None:
        rep('  sweep %.2f deg, narrowest window found %.2f deg at %s - %s'
            % (_res['step'], _res['narrowest'], _res['at'],
               'resolved' if _res['ok'] else 'TOO CLOSE TO THE STEP'))
    for c in chain:
        rep('  %s closes: land fillet r %.3f, corner round r %.3f, smallest stator ring '
            '%.3f mm' % (c['link'], c['fillet_r'], c['corner_r'], c['stator_margin']))
    rep('')

    # ---- arm component at identity ----
    identity = adsk.core.Matrix3D.create()
    arm_occ = root.occurrences.addNewComponent(identity)
    arm_occ.component.name = unique_name(design, ARM_COMPONENT_NAME)
    arm_comp = arm_occ.component
    rep('Component: ' + arm_comp.name)

    # ---- 1. links first: body pre-transformed into the arm frame, component at identity ----
    g = armgen
    for L, R_ab, t_ab, routed in link_specs:
        a, b, lname = L['a'], L['b'], L['name']
        RA, tA = frames[a]
        link_occ = arm_comp.occurrences.addNewComponent(identity)
        link_occ.component.name = unique_name(design, lname)
        FA = Frame(RA, [v * 1000.0 for v in tA])            # frame A in the arm (= world) frame
        body, info = build_link_body(link_occ.component, FA, R_ab, t_ab, L, routed)
        body.name = lname
        pattern = routed['pattern']
        # one description for any route: armgen.route_report walks the route's own segments
        # and joins, so the build has no per-pattern branch left anywhere (EXO-96).
        detail = g.route_report(routed)
        rep('%s (%s): %s rotor pad -> %s stator pad; B origin in %s frame (mm) = '
            '(%.1f, %.1f, %.1f); %s; %d features, %d body, %d faces, volume %.0f mm3'
            % (lname, pattern, a, b, a, t_ab[0], t_ab[1], t_ab[2], detail,
               link_occ.component.features.count, link_occ.component.bRepBodies.count,
               body.faces.count, body.volume * 1000.0))
    for n1, n2, c in clearances:
        rep('%s / %s computed clearance (sampled, 0.5 mm): %.2f mm (minimum %.1f)'
            % (n1, n2, c, armgen.MIN_CLEARANCE))

    # ---- 2. module source: insert once at root if needed, reuse everywhere ----
    root_insert = None
    if module_comp is None:
        root_insert = root.occurrences.addByInsert(data_file, identity, True)
        module_comp = root_insert.component

    # ---- 3. joint wrappers. The matrix given to addNewComponent already places
    #      them; set_occ_matrix then re-asserts it through the root-context proxy
    #      (a native occurrence refuses `transform2`), and how it went is reported. ----
    wrappers = []
    for j in JOINTS:
        R, t = frames[j['label']]
        m = matrix_from_frame(R, [v * M_TO_CM for v in t])
        wrapper = arm_comp.occurrences.addNewComponent(m)
        wrapper.component.name = unique_name(design, '%s_%s' % (j['label'], j['name']))
        how = set_occ_matrix(wrapper, m, arm_occ)
        # The matrix given to addExistingComponent is interpreted in the ROOT frame,
        # not relative to the owning component: identity parks every module on the
        # document origin (measured - that is the "all modules at the same pose" bug).
        # The arm component is at identity, so the wrapper matrix is also its world
        # matrix; the read-back below fails loudly if that ever stops holding.
        inner = wrapper.component.occurrences.addExistingComponent(module_comp, m)
        inner.isLightBulbOn = True
        wrappers.append((j, m, wrapper, how))
    if root_insert is not None:
        if not root_insert.deleteMe():
            rep('WARNING: stray module copy at the root origin could not be deleted')

    # ---- 4. capture positions (parametric designs) ----
    captured = False
    if parametric and design.snapshots.hasPendingSnapshot:
        design.snapshots.add()
        captured = True
    rep('Snapshot captured: %s' % captured)
    rep('')

    # ---- 5. read back what the document actually holds: the transform through
    #      the root proxy AND the world position of the module geometry itself ----
    problems = 0
    for j, m, wrapper, how in wrappers:
        proxy = occ_root_proxy(wrapper, arm_occ)
        got = proxy.transform
        err = matrix_diff(got, m)
        ok = err < 1e-4
        problems += 0 if ok else 1
        rep('%s %s: intended %s [set via %s]' % (j['label'], j['name'], describe_matrix(m), how))
        rep('    read back %s -> %s (max diff %.2e cm)'
            % (describe_matrix(got), 'OK' if ok else 'MISMATCH', err))
        # the module itself: its transform is relative to the wrapper, so the world
        # pose is wrapper * inner. Anything but the joint frame means the module is
        # not where the wrapper says it is (the round-1 symptom).
        n_inner = proxy.childOccurrences.count
        if n_inner != 1:
            rep('    module under wrapper: PROBLEM (%d child occurrences)' % n_inner)
            problems += 1
        else:
            world = proxy.childOccurrences.item(0).transform.copy()
            world.transformBy(got)
            werr = matrix_diff(world, m)
            wok = werr < 1e-4
            problems += 0 if wok else 1
            rep('    module world pose %s -> %s (max diff %.2e cm)'
                % (describe_matrix(world), 'OK' if wok else 'MISPLACED', werr))
    arm_err = matrix_diff(occ_matrix(arm_occ), identity)
    rep('arm component transform: %s (diff %.2e)' % ('identity' if arm_err < 1e-6 else 'NOT identity', arm_err))
    if arm_err >= 1e-6:
        problems += 1

    # ---- 6. interference check over everything under the arm: links AND the module
    #      bodies one level deeper under each J* wrapper (KNUTH-2). Module-internal
    #      overlaps (press-fit inserts, screws inside `sensor module 2`) and slivers
    #      thinner than armgen.INTERFERENCE_DEPTH_TOL are listed but not failures. ----
    rep('')
    n_bodies, hits = check_interference(design, arm_occ)
    fails, slivers, internal = [], [], []
    for kind, a, b, vol, bb in hits:
        {'FAIL': fails, 'sliver': slivers, 'module-internal': internal}[kind].append((a, b, vol, bb))
    rep('Interference check: %d bodies (links + modules), %d interference(s): %d FAIL, '
        '%d sliver(s) <= %.2f mm deep ignored, %d module-internal ignored'
        % (n_bodies, len(hits), len(fails), len(slivers), armgen.INTERFERENCE_DEPTH_TOL, len(internal)))
    for a, b, vol, bb in fails:
        rep('    FAIL interference %s <-> %s volume=%.1f mm3 bbox(world mm)=%s' % (a, b, vol, fmt_bbox(bb)))
    for a, b, vol, bb in slivers:
        rep('    sliver %s <-> %s volume=%.2f mm3 depth=%.3f mm at %s'
            % (a, b, vol, min(bb[1][i] - bb[0][i] for i in range(3)), fmt_bbox(bb)))
    if internal:
        counts = {}
        for a, b, vol, bb in internal:
            k = '%s <-> %s %.1f mm3' % (a, b, vol)
            counts[k] = counts.get(k, 0) + 1
        rep('    module-internal (pre-existing in %s): %s' % (
            MODULE_DOC_NAME, ', '.join('%dx %s' % (n, k) for k, n in sorted(counts.items()))))
    rep('Interference result: %s' % ('OK (0 over links + modules)' if not fails
                                     else 'FAIL (%d)' % len(fails)))
    problems += len(fails)

    head = 'BuildArm done.' if problems == 0 else 'BuildArm finished with %d PROBLEM(S) - see below.' % problems
    text = head + '\n\n' + '\n'.join(report)
    if fails and not interactive:
        write_report(text)
        raise RuntimeError('BuildArm: %d interference FAIL(s) between generated bodies and '
                           'links/modules - see %s' % (len(fails), REPORT_PATH))
    return text


def fmt_bbox(bb):
    if bb is None:
        return 'n/a'
    return 'x[%.2f,%.2f] y[%.2f,%.2f] z[%.2f,%.2f]' % (bb[0][0], bb[1][0], bb[0][1], bb[1][1], bb[0][2], bb[1][2])


def run(context):
    """Scripts and Add-Ins entry point: build, write the report file, show it."""
    ui = None
    streamed = []
    try:
        app = adsk.core.Application.get()
        ui = app.userInterface
        design = adsk.fusion.Design.cast(app.activeProduct)
        text = build_arm(app, ui, design, streamed.append, interactive=True)
        wrote = write_report(text)
        ui.messageBox(text + ('\n\nReport: ' + REPORT_PATH if wrote
                              else '\n\n(report file could not be written)'))
    except Cancelled:
        return
    except Exception:
        text = ('BuildArm failed:\n' + traceback.format_exc()
                + '\n\nPartial report:\n' + '\n'.join(streamed))
        write_report(text)
        if ui:
            ui.messageBox(text)
