"""EXO-261: put one real 5972K159 bearing and one real XL330 into the open
"tool_organizer_exo258" design, measure part-to-wall clearance in Fusion, save (screenshots: shot_parts_exo261.py).

Bodies come from `sensor module 2.step` (imported to a scratch document that is closed
unsaved), copied with TemporaryBRepManager, moved, and added as separate components
(each its own base feature) - never fused to the box. Idempotent: earlier copies are
deleted first. The box geometry is not touched.

Placement (EXO-258 layout, bin inner 47.5 x 64.0, floor z = 2.0, labels embossed 0.6 at
bin centre +-5 mm, under both parts): parts are centred on the bin and rest ON THE LABELS,
z = 2.6, because z = 2.0 would put them through the embossed text.
  bearing: bin row 0 col 0, centre (-74.25, 66.0), axis vertical (as in the module).
  XL330:   bin row 2 col 0, centre (-74.25, -66.0), rotated 90 deg about Y so its 20 mm
           side is vertical: footprint 26 (X) x 34 (Y), 20 tall.

Run: /usr/bin/python3 tools/fusion_run.py tools/bridge_scripts/place_parts_exo261.py --timeout 300
"""
import importlib
import math
import sys

sys.path.insert(0, '/Users/esteban/repos/exo/fusion_scripts/BuildArm')
import BuildArm
importlib.reload(BuildArm)

NAME = 'tool_organizer_exo258'
STEP = '/Users/esteban/repos/exo/gento_luna/Gento Luna_URDF 20260428/urdf/sensor module 2.step'
Z_REST = 0.26                       # cm: floor 2.0 + label 0.6
BIN_X = (-9.8, -5.05)               # cm, column 0 inner walls
PARTS = [  # (component name, STEP component, bin centre cm, bin y walls cm, rotate about Y)
    ('bearing_5972K159_exo261', '5972K159_Ball Bearing', (-7.425, 6.6), (3.4, 9.8), False),
    ('XL330_exo261', 'XL330 v2', (-7.425, -6.6), (-9.8, -3.4), True),
]
P3 = adsk.core.Point3D.create
V3 = adsk.core.Vector3D.create
tbm = adsk.fusion.TemporaryBRepManager.get()

org = None
for i in range(app.documents.count):
    if app.documents.item(i).name.split(' v')[0] == NAME:
        org = app.documents.item(i)
if org is None:
    raise RuntimeError('%s is not open' % NAME)
org.activate()
des = adsk.fusion.Design.cast(app.activeProduct)
root = des.rootComponent
box = root.bRepBodies.item(0)
log('organizer %r, box body %r' % (org.name, box.name))

for i in range(root.occurrences.count - 1, -1, -1):
    o = root.occurrences.item(i)
    if o.component.name.endswith('_exo261'):
        log('deleting earlier %r' % o.component.name)
        o.deleteMe()


def union_bbox(bodies):
    lo = [1e9] * 3
    hi = [-1e9] * 3
    for b in bodies:
        bb = b.boundingBox
        for k, a in enumerate('xyz'):
            lo[k] = min(lo[k], getattr(bb.minPoint, a))
            hi[k] = max(hi[k], getattr(bb.maxPoint, a))
    return lo, hi


# --- source bodies from the module STEP (scratch doc, closed unsaved)
im = app.importManager
tmp = im.importToNewDocument(im.createSTEPImportOptions(STEP))
troot = adsk.fusion.Design.cast(tmp.products.itemByProductType('DesignProductType')).rootComponent
copies = {}
for name, src, _c, _w, _r in PARTS:
    occ = [o for o in troot.allOccurrences if o.component.name == src]
    if len(occ) != 1:
        raise RuntimeError('%d occurrences of %r in the module STEP' % (len(occ), src))
    copies[name] = [tbm.copy(occ[0].bRepBodies.item(i)) for i in range(occ[0].bRepBodies.count)]
    log('copied %d bodies of %r' % (len(copies[name]), src))
tmp.close(False)
org.activate()
des = adsk.fusion.Design.cast(app.activeProduct)
root = des.rootComponent
box = root.bRepBodies.item(0)

placed = {}
for name, src, (cx, cy), (wy0, wy1), rot in PARTS:
    bodies = copies[name]
    if rot:
        lo, hi = union_bbox(bodies)
        c = P3(*[(lo[k] + hi[k]) / 2 for k in range(3)])
        m = adsk.core.Matrix3D.create()
        m.setToRotation(math.pi / 2, V3(0, 1, 0), c)
        for b in bodies:
            tbm.transform(b, m)
    lo, hi = union_bbox(bodies)
    m = adsk.core.Matrix3D.create()
    m.translation = V3(cx - (lo[0] + hi[0]) / 2, cy - (lo[1] + hi[1]) / 2, Z_REST - lo[2])
    for b in bodies:
        tbm.transform(b, m)
    occ = root.occurrences.addNewComponent(adsk.core.Matrix3D.create())
    comp = occ.component
    comp.name = name
    bf = comp.features.baseFeatures.add()
    bf.startEdit()
    for b in bodies:
        comp.bRepBodies.add(b, bf)
    bf.finishEdit()
    lo, hi = union_bbox([comp.bRepBodies.item(i) for i in range(comp.bRepBodies.count)])
    log('%s: %d bodies, bbox mm X %.3f..%.3f Y %.3f..%.3f Z %.3f..%.3f (%.3f x %.3f x %.3f)' % (
        name, comp.bRepBodies.count, 10 * lo[0], 10 * hi[0], 10 * lo[1], 10 * hi[1], 10 * lo[2], 10 * hi[2],
        10 * (hi[0] - lo[0]), 10 * (hi[1] - lo[1]), 10 * (hi[2] - lo[2])))
    placed[name] = (occ, (wy0, wy1))

# --- clearance measured in Fusion: min distance part bodies -> each bin wall face
mm = app.measureManager


def wall_faces(axis, coord, span_axis, span):
    out = []
    for f in box.faces:
        pl = adsk.core.Plane.cast(f.geometry)
        if pl is None:
            continue
        n = pl.normal
        if abs(abs(getattr(n, axis)) - 1) > 1e-6:
            continue
        if abs(getattr(pl.origin, axis) - coord) > 1e-4:
            continue
        bb = f.boundingBox
        if getattr(bb.maxPoint, span_axis) < span[0] or getattr(bb.minPoint, span_axis) > span[1]:
            continue
        out.append(f)
    return out


results = {}
for name, (occ, (wy0, wy1)) in placed.items():
    bodies = [occ.bRepBodies.item(i) for i in range(occ.bRepBodies.count)]
    walls = {'-X': ('x', BIN_X[0], 'y', (wy0, wy1)), '+X': ('x', BIN_X[1], 'y', (wy0, wy1)),
             '-Y': ('y', wy0, 'x', BIN_X), '+Y': ('y', wy1, 'x', BIN_X)}
    res = {}
    for tag, (ax, co, sa, sp) in walls.items():
        faces = wall_faces(ax, co, sa, sp)
        if not faces:
            res[tag] = None
            log('%s %s: no wall face found at %s=%.3f' % (name, tag, ax, co))
            continue
        d = min(mm.measureMinimumDistance(b, f).value for b in bodies for f in faces)
        res[tag] = 10 * d
    floor_d = min(mm.measureMinimumDistance(b, box).value for b in bodies) * 10
    results[name] = res
    log('CLEARANCE %s (mm): %s; min distance to box body (labels/floor) %.3f' % (
        name, ', '.join('%s %.3f' % (k, v) if v is not None else '%s ?' % k for k, v in res.items()), floor_d))

# interference check part vs box
coll = adsk.core.ObjectCollection.create()
coll.add(box)
for name, (occ, _) in placed.items():
    for i in range(occ.bRepBodies.count):
        coll.add(occ.bRepBodies.item(i))
ii = des.createInterferenceInput(coll)
ii.areCoincidentFacesIncluded = False
ir = des.analyzeInterference(ii)
hits = []
for k in range(ir.count):
    r = ir.item(k)
    if box in (r.entityOne, r.entityTwo) or r.entityOne == box or r.entityTwo == box:
        hits.append('%s/%s %.4f cm3' % (r.entityOne.name, r.entityTwo.name, r.interferenceBody.volume))
log('interference with box: %s' % (hits or 'none'))

log(BuildArm.save_active_document(app, why='EXO-261: bearing + XL330 placed'))

# screenshots: tools/bridge_scripts/shot_parts_exo261.py
d, df, ever, upd = BuildArm.document_state(app)
log('RESULT %r saved_ever=%s up_to_date=%s (%s) version %s' % (
    d.name, ever, upd, BuildArm.data_file_where(df), df.versionNumber if df else None))
