"""EXO-225: measure the rotor stack of `sensor module 2` from the STEP, pure Python.

Prints, in the MODULE frame (origin = rotor top face centre, +Z out of the face):
  * every product's radial / axial extent (vertex bbox);
  * for the two rotor parts and the screws/nuts: every cylindrical surface with its
    axis, its (x,y) position, its radius and the z span of the vertices that lie on it
    -- i.e. every hole and every boss, with its depth;
  * the horn screws' head cylinders and the hex-nut pockets.

Run: /usr/bin/python3 tools/bridge_scripts/measure_exo225_rotor.py
Nothing is written.
"""
import math
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, '..', '..'))
sys.path.insert(0, os.path.join(ROOT, 'tools'))
import steplib                                     # noqa: E402

STEP = os.path.join(ROOT, 'gento_luna', 'Gento Luna_URDF 20260428', 'urdf',
                    'sensor module 2.step')

s = steplib.Step(STEP)
occs = s.occurrences()

print('=== 1. product extents in the module frame (mm) ===')
print('%-36s %8s %8s %8s %8s %7s' % ('product', 'r_min', 'r_max', 'z_min', 'z_max', 'nvert'))
byname = {}
for path, name, pd, T in occs:
    vs = s.vertices(pd)
    if not vs:
        continue
    w = [steplib._apply(T, v) for v in vs]
    r = [math.hypot(p[0], p[1]) for p in w]
    z = [p[2] for p in w]
    byname.setdefault(name, []).append((pd, T, w))
    print('%-36s %8.3f %8.3f %8.3f %8.3f %7d'
          % (name, min(r), max(r), min(z), max(z), len(w)))


def cyl_report(name, rmax=None):
    """Every cylindrical surface of `name`, grouped by (axis, x, y, radius), with the
    z span of the vertices that sit on that cylinder."""
    if name not in byname:
        print('  (no product %r)' % name)
        return
    print('\n--- %s: cylindrical surfaces (module frame) ---' % name)
    print('   %8s %8s %8s %9s %9s %9s  %s'
          % ('x', 'y', 'r', 'ax_z', 'z_lo', 'z_hi', 'note'))
    rows = []
    for pd, T, w in byname[name]:
        for c, a, rad in s.cylinders(pd):
            cw = steplib._apply(T, c)
            aw = steplib._rot(T, a)
            rows.append((cw, aw, rad))
    out = {}
    for cw, aw, rad in rows:
        # axis direction normalised sign so +z or +x preferred
        ax = list(aw)
        if ax[2] < -1e-9 or (abs(ax[2]) < 1e-9 and ax[0] < -1e-9):
            ax = [-v for v in ax]
        key = (round(cw[0], 3), round(cw[1], 3), round(rad, 4),
               round(ax[0], 3), round(ax[1], 3), round(ax[2], 3))
        out.setdefault(key, []).append(cw[2])
    for key in sorted(out, key=lambda k: (-k[2], k[0], k[1])):
        x, y, rad, axx, axy, axz = key
        # vertices lying on this cylinder (within 0.02 mm of its radius, same axis)
        zs = []
        for pd, T, w in byname[name]:
            for p in w:
                if abs(axz - 1.0) < 1e-6:
                    d = math.hypot(p[0] - x, p[1] - y)
                else:
                    d = None
                if d is not None and abs(d - rad) < 0.02:
                    zs.append(p[2])
        zlo = min(zs) if zs else float('nan')
        zhi = max(zs) if zs else float('nan')
        rr = math.hypot(x, y)
        ang = math.degrees(math.atan2(y, x)) % 360.0
        note = 'at r %.3f, %.2f deg' % (rr, ang) if rr > 0.01 else 'on axis'
        print('   %8.3f %8.3f %8.4f %9.3f %9.3f %9.3f  %s'
              % (x, y, rad, axz, zlo, zhi, note))


print('\n\n=== 2. rotor parts ===')
cyl_report('Component2')
cyl_report('Component3')

print('\n\n=== 3. fasteners ===')
for nm in ('4x pan_head_philip_mc_screw_m1-6', '4x m3 hex nut', '3x m3_6mm_insert'):
    cyl_report(nm)

print('\n\n=== 4. fastener instances: per-occurrence bbox (module frame) ===')
for path, name, pd, T in occs:
    if name not in ('4x pan_head_philip_mc_screw_m1-6', '4x m3 hex nut'):
        continue
    vs = s.vertices(pd)
    if not vs:
        continue
    w = [steplib._apply(T, v) for v in vs]
    x = [p[0] for p in w]
    y = [p[1] for p in w]
    z = [p[2] for p in w]
    cx, cy = (min(x) + max(x)) / 2.0, (min(y) + max(y)) / 2.0
    print('%-36s centre (%7.3f,%7.3f) r %6.3f ang %7.2f  z %8.3f..%8.3f'
          % ('/'.join(path[1:]) or name, cx, cy, math.hypot(cx, cy),
             math.degrees(math.atan2(cy, cx)) % 360.0, min(z), max(z)))

print('\n\n=== 5. XL330 bodies near the horn (z > -20) ===')
for path, name, pd, T in occs:
    if 'XL330' not in name:
        continue
    vs = s.vertices(pd)
    if not vs:
        continue
    w = [steplib._apply(T, v) for v in vs]
    hi = [p for p in w if p[2] > -20.0]
    if not hi:
        continue
    r = [math.hypot(p[0], p[1]) for p in hi]
    z = [p[2] for p in hi]
    print('%-36s r %7.3f..%7.3f  z %8.3f..%8.3f  (%d verts above -20)'
          % ('/'.join(path[1:]) or name, min(r), max(r), min(z), max(z), len(hi)))
for path, name, pd, T in occs:
    if 'XL330' not in name:
        continue
    for c, a, rad in s.cylinders(pd):
        cw = steplib._apply(T, c)
        aw = steplib._rot(T, a)
        if abs(abs(aw[2]) - 1.0) > 1e-6:
            continue
        if cw[2] < -22.0:
            continue
        print('   XL330 z-cyl r %7.3f at (%7.3f,%7.3f) origin z %8.3f  [%s]'
              % (rad, cw[0], cw[1], cw[2], name))
