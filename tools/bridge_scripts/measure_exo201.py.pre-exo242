"""EXO-201 measurement: where the REAL XL330 body sits in the module frame.

EXO-187 built a proxy box (x +-10, y -9.5..24.5, z -36.5..-24.5) beside every module,
on the belief that `sensor module 2` carries no actuator body. It does (EXO-192): the
component `XL330 v2` with `Body1`. This measures that real body's box in each module's
own frame and compares it with the proxy rectangle, so the proxy can be dropped.

Run: /usr/bin/python3 tools/fusion_run.py tools/bridge_scripts/measure_exo201.py --timeout 300
"""
import sys
import importlib

sys.path.insert(0, '/Users/esteban/repos/exo/fusion_scripts/BuildArm')
import armgen
import BuildArm
import BuildArmGen
importlib.reload(armgen)
importlib.reload(BuildArm)
importlib.reload(BuildArmGen)

root = design.rootComponent
tbm = adsk.fusion.TemporaryBRepManager.get()
CM = 10.0   # cm -> mm

arm_occ = None
for i in range(root.occurrences.count):
    o = root.occurrences.item(i)
    if o.component.name.startswith(BuildArmGen.ARM_NAME):
        arm_occ = o
if arm_occ is None:
    raise RuntimeError('no %s in this document' % BuildArmGen.ARM_NAME)
log('arm: %s' % arm_occ.component.name)


def box_in(body, inv):
    """Axis-aligned box of `body` after `inv`, in mm."""
    tmp = tbm.copy(body)
    tbm.transform(tmp, inv)
    bb = tmp.boundingBox
    return ((bb.minPoint.x * CM, bb.minPoint.y * CM, bb.minPoint.z * CM),
            (bb.maxPoint.x * CM, bb.maxPoint.y * CM, bb.maxPoint.z * CM))


def walk(occ, depth, out):
    for i in range(occ.childOccurrences.count):
        sub = occ.childOccurrences.item(i)
        out.append((depth, sub))
        walk(sub, depth + 1, out)


# ---- one full tree dump under the first wrapper, so the names are on record ----------
wrappers = [arm_occ.childOccurrences.item(i)
            for i in range(arm_occ.childOccurrences.count)
            if arm_occ.childOccurrences.item(i).component.name.startswith('G')]
log('%d wrapper(s): %s' % (len(wrappers), ', '.join(w.component.name for w in wrappers)))
proxy_occs = [arm_occ.childOccurrences.item(i)
              for i in range(arm_occ.childOccurrences.count)
              if arm_occ.childOccurrences.item(i).component.name.startswith(
                  'XL330_')]
log('%d XL330_* proxy component(s) present: %s'
    % (len(proxy_occs), ', '.join(o.component.name for o in proxy_occs) or '-'))

if wrappers:
    kids = []
    walk(wrappers[0], 1, kids)
    log('tree under %s:' % wrappers[0].component.name)
    for d, k in kids:
        log('  %s%s  (%d bodies)' % ('  ' * d, k.component.name, k.bRepBodies.count))
        for bi in range(k.bRepBodies.count):
            log('  %s  . %s' % ('  ' * d, k.bRepBodies.item(bi).name))

# ---- the XL330 body in every module frame -------------------------------------------
AX0, AX1, AY0, AY1 = armgen.actuator_rect(0.0)
AZ0, AZ1 = armgen.ACT_Z[0], armgen.STATOR_UNDERSIDE_Z
log('')
log('proxy rectangle (armgen): x %.3f..%.3f  y %.3f..%.3f  z %.3f..%.3f'
    % (AX0, AX1, AY0, AY1, AZ0, AZ1))
log('%-28s %-22s %-24s %-24s %-24s' % ('wrapper', 'body', 'x (mm)', 'y (mm)', 'z (mm)'))
for w in wrappers:
    wm = w.transform.copy()
    if not wm.invert():
        raise RuntimeError('wrapper matrix not invertible: %s' % w.component.name)
    kids = []
    walk(w, 1, kids)
    for d, k in kids:
        nm = k.component.name
        for bi in range(k.bRepBodies.count):
            b = k.bRepBodies.item(bi)
            if 'XL330' not in nm and 'XL330' not in b.name:
                continue
            lo, hi = box_in(b, wm)
            try:
                vs = '%.1f mm3' % (b.volume * 1000.0)
            except Exception as e:
                vs = 'n/a (%s)' % type(e).__name__
            log('%-28s %-22s [%8.3f,%8.3f] [%8.3f,%8.3f] [%8.3f,%8.3f] vol %s'
                % (w.component.name, '%s/%s' % (nm, b.name),
                   lo[0], hi[0], lo[1], hi[1], lo[2], hi[2], vs))
            log('    vs proxy: dx %+.3f/%+.3f  dy %+.3f/%+.3f  dz(back) %+.3f  top %+.3f'
                % (lo[0] - AX0, hi[0] - AX1, lo[1] - AY0, hi[1] - AY1,
                   lo[2] - AZ0, hi[2] - AZ1))
    # stator, as a datum check on the frame itself
    for d, k in kids:
        for bi in range(k.bRepBodies.count):
            b = k.bRepBodies.item(bi)
            if k.component.name not in ('Component1', 'Component2', 'Component3'):
                continue
            lo, hi = box_in(b, wm)
            log('    datum %s/%s x [%7.3f,%7.3f] y [%7.3f,%7.3f] z [%8.3f,%8.3f] '
                '(stator underside should be %.3f)'
                % (k.component.name, b.name, lo[0], hi[0], lo[1], hi[1], lo[2], hi[2],
                   armgen.STATOR_UNDERSIDE_Z))
log('EXO-201 measurement done')
